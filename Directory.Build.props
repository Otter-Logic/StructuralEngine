<Project>

  <PropertyGroup>
    <!-- Repo-wide paths -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

    <!-- Rhino 8 on Windows runs .NET 7. Matched to Core, MachineLearning and the
         other toolkits so every assembly loads into one process without a shim.

         Nothing here touches a Rhino API. The clustering is arithmetic over a
         table of numbers, so its tests run on a hosted CI runner with no Rhino
         and no licence. `-windows` follows the rest of the org, not a need. -->
    <TargetFramework>net7.0-windows</TargetFramework>
    <RhinoVersion>8.0.23304.9001</RhinoVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <Version>0.1.0</Version>
    <Authors>OtterLogic</Authors>
    <Company>OtterLogic</Company>

    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NETSDK1138;NU1701;CA1416</NoWarn>
  </PropertyGroup>

</Project>
